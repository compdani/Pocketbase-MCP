{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/compdani/pocketbase-mcp/manifest.schema.json",
  "title": "PocketBase MCP manifest",
  "type": "object",
  "required": ["schemaVersion", "collections"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"type": "string", "enum": ["1"]},
    "toolMode": {"type": "string", "enum": ["per_collection", "generic"], "default": "per_collection"},
    "maxGeneratedTools": {"type": "integer", "minimum": 0, "default": 40},
    "collections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["collection", "operations"],
        "additionalProperties": false,
        "properties": {
          "collection": {"type": "string", "minLength": 1},
          "alias": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"},
          "description": {"type": "string"},
          "optional": {"type": "boolean", "default": false},
          "operations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "enum": ["describe", "search", "fetch", "create", "update", "delete"]}
          },
          "presentation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "titleFields": {"type": "array", "items": {"type": "string"}},
              "titleSep": {"type": "string"},
              "urlField": {"type": "string"},
              "summaryFields": {"type": "array", "items": {"type": "string"}},
              "queryFields": {"type": "array", "items": {"type": "string"}},
              "expand": {"type": "array", "items": {"type": "string"}}
            }
          },
          "fields": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "read": {"type": "array", "items": {"type": "string"}},
              "create": {"type": "array", "items": {"type": "string"}},
              "update": {"type": "array", "items": {"type": "string"}}
            }
          },
          "search": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "textFields": {"type": "array", "items": {"type": "string"}},
              "filters": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"type": "string", "enum": ["eq", "neq", "gt", "gte", "lt", "lte", "in", "contains"]}
                }
              },
              "sortFields": {"type": "array", "items": {"type": "string"}},
              "defaultSort": {"type": "array", "items": {"type": "string"}},
              "defaultLimit": {"type": "integer", "minimum": 1},
              "maxLimit": {"type": "integer", "minimum": 1}
            }
          },
          "relations": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["target", "fields"],
              "additionalProperties": false,
              "properties": {
                "target": {"type": "string"},
                "fields": {"type": "array", "items": {"type": "string"}},
                "maxDepth": {"type": "integer", "minimum": 1, "maximum": 3, "default": 1}
              }
            }
          },
          "policy": {"type": "string", "description": "authenticated, superuser, collection:<name>, field:<name>:<value>, or a host-registered policy name"}
        }
      }
    }
  }
}
